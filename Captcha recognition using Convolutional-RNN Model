da\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# Load dataset\nclass CaptchaDataset(Dataset):\n    def __init__(self, image_folder, char_to_idx, transform=None):\n        self.image_folder = image_folder\n        self.image_files = [f for f in os.listdir(image_folder) if f.endswith(('.png', '.jpg', '.jpeg'))]  # Filter valid image files\n        if not self.image_files:\n            raise ValueError(f\"No valid image files found in {image_folder}. Supported formats: .png, .jpg, .jpeg\")\n        self.transform = transform\n        self.char_to_idx = char_to_idx\n\n    def __len__(self):\n        return len(self.image_files)\n\n    def __getitem__(self, idx):\n        img_name = self.image_files[idx]\n        img_path = os.path.join(self.image_folder, img_name)\n        image = Image.open(img_path).convert('L')  # Convert to grayscale\n\n        # Resize image to a fixed size (e.g., 50x200)\n        image = image.resize((200, 50))  # (width, height)\n        \n        label = os.path.splitext(img_name)[0].lower()  # Convert label to lowercase\n        label_indices = [self.char_to_idx[char] for char in label]  # Convert label to indices\n\n        if self.transform:\n            image = self.transform(image)\n\n        return image, torch.tensor(label_indices, dtype=torch.long)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T08:52:28.786244Z","iopub.execute_input":"2025-02-12T08:52:28.786577Z","iopub.status.idle":"2025-02-12T08:52:28.793614Z","shell.execute_reply.started":"2025-02-12T08:52:28.786550Z","shell.execute_reply":"2025-02-12T08:52:28.792772Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# Preprocessing and EDA\ndef preprocess_and_eda(image_folder, char_to_idx, idx_to_char):\n    \"\"\"\n    Perform exploratory data analysis (EDA) on the dataset.\n    \n    Args:\n        image_folder (str): Path to the folder containing the CAPTCHA images.\n        char_to_idx (dict): Mapping from characters to integer indices.\n        idx_to_char (dict): Mapping from integer indices to characters.\n    \"\"\"\n    # Load dataset\n    try:\n        dataset = CaptchaDataset(image_folder, char_to_idx, transform=transforms.ToTensor())\n    except ValueError as e:\n        print(e)\n        return None\n\n    print(f\"Total samples in dataset: {len(dataset)}\")\n\n    # Plot sample images\n    plt.figure(figsize=(10, 5))\n    for i in range(min(5, len(dataset))):  # Ensure we don't exceed dataset size\n        image, label_indices = dataset[i]\n        label = ''.join([idx_to_char[idx.item()] for idx in label_indices])  # Decode label\n        plt.subplot(1, 5, i+1)\n        plt.imshow(image.squeeze(), cmap='gray')\n        plt.title(label)\n        plt.axis('off')\n    plt.show()\n\n    # Analyze label lengths\n    label_lengths = [len(label_indices) for _, label_indices in dataset]\n    if not label_lengths:\n        print(\"No labels found in the dataset.\")\n        return None\n\n    sns.histplot(label_lengths, bins=range(min(label_lengths), max(label_lengths) + 1))\n    plt.title(\"Distribution of Label Lengths\")\n    plt.xlabel(\"Label Length\")\n    plt.ylabel(\"Frequency\")\n    plt.show()\n\n    return dataset","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T08:54:17.898516Z","iopub.execute_input":"2025-02-12T08:54:17.899134Z","iopub.status.idle":"2025-02-12T08:54:17.907219Z","shell.execute_reply.started":"2025-02-12T08:54:17.899104Z","shell.execute_reply":"2025-02-12T08:54:17.905851Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"# CNN Encoder\nclass CNNEncoder(nn.Module):\n    def __init__(self):\n        super(CNNEncoder, self).__init__()\n        self.cnn = nn.Sequential(\n            nn.Conv2d(1, 32, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.MaxPool2d(kernel_size=2, stride=2),\n            nn.Conv2d(32, 64, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.MaxPool2d(kernel_size=2, stride=2),\n            nn.Conv2d(64, 128, kernel_size=3, stride=1, padding=1),\n            nn.ReLU(),\n            nn.MaxPool2d(kernel_size=2, stride=2)\n        )\n\n    def forward(self, x):\n        return self.cnn(x)\n\n# RNN Decoder with Attention\nclass RNNDecoder(nn.Module):\n    def __init__(self, hidden_size, output_size, num_layers=1):\n        super(RNNDecoder, self).__init__()\n        self.hidden_size = hidden_size\n        self.output_size = output_size\n        self.num_layers = num_layers\n\n        self.embedding = nn.Embedding(output_size, hidden_size)\n        self.lstm = nn.LSTM(hidden_size, hidden_size, num_layers, batch_first=True)\n        self.attention = nn.Linear(hidden_size * 2, 1)\n        self.fc = nn.Linear(hidden_size, output_size)\n\n    def forward(self, encoder_outputs, hidden, cell):\n        seq_length = encoder_outputs.size(1)\n        hidden_repeated = hidden[-1].unsqueeze(1).repeat(1, seq_length, 1)\n        energy = torch.tanh(self.attention(torch.cat((hidden_repeated, encoder_outputs), dim=2)))\n        attention_weights = torch.softmax(energy, dim=1)\n        context_vector = torch.sum(attention_weights * encoder_outputs, dim=1)\n\n        output = self.fc(context_vector)\n        return output, attention_weights","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T08:54:21.817599Z","iopub.execute_input":"2025-02-12T08:54:21.818202Z","iopub.status.idle":"2025-02-12T08:54:21.827109Z","shell.execute_reply.started":"2025-02-12T08:54:21.818173Z","shell.execute_reply":"2025-02-12T08:54:21.826259Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"\"\"\"New Model architecture\"\"\"\nclass CNNRNNModel(nn.Module):\n    def __init__(self, cnn_encoder, rnn_decoder, num_classes):\n        super(CNNRNNModel, self).__init__()\n        self.cnn_encoder = cnn_encoder\n        self.rnn_decoder = rnn_decoder\n        self.num_classes = num_classes\n\n    def forward(self, x):\n        batch_size = x.size(0)\n        encoder_outputs = self.cnn_encoder(x)\n        encoder_outputs = encoder_outputs.view(batch_size, -1, 128)  # (batch_size, seq_len=150, 128)\n        seq_len = encoder_outputs.size(1)  # Get the encoder's sequence length (e.g., 150)\n\n        hidden = torch.zeros(self.rnn_decoder.num_layers, batch_size, self.rnn_decoder.hidden_size).to(device)\n        cell = torch.zeros(self.rnn_decoder.num_layers, batch_size, self.rnn_decoder.hidden_size).to(device)\n\n        outputs = []\n        attention_weights = []\n        for _ in range(seq_len):  # Iterate over encoder's sequence length\n            output, attn = self.rnn_decoder(encoder_outputs, hidden, cell)\n            outputs.append(output)\n            attention_weights.append(attn)\n\n        outputs = torch.stack(outputs, dim=1)  # (batch_size, seq_len=150, num_classes)\n        attention_weights = torch.stack(attention_weights, dim=1)\n        return outputs, attention_weights\n\n# # CNN-RNN Model\n# class CNNRNNModel(nn.Module):\n#     def __init__(self, cnn_encoder, rnn_decoder, num_classes):\n#         super(CNNRNNModel, self).__init__()\n#         self.cnn_encoder = cnn_encoder\n#         self.rnn_decoder = rnn_decoder\n#         self.num_classes = num_classes\n\n#     def forward(self, x):\n#         batch_size = x.size(0)\n#         encoder_outputs = self.cnn_encoder(x)\n#         encoder_outputs = encoder_outputs.view(batch_size, -1, 128)  # Reshape for RNN\n\n#         hidden = torch.zeros(self.rnn_decoder.num_layers, batch_size, self.rnn_decoder.hidden_size).to(device)\n#         cell = torch.zeros(self.rnn_decoder.num_layers, batch_size, self.rnn_decoder.hidden_size).to(device)\n\n#         outputs = []\n#         attention_weights = []\n#         for _ in range(5):  # Assuming max label length is 5\n#             output, attn = self.rnn_decoder(encoder_outputs, hidden, cell)\n#             outputs.append(output)\n#             attention_weights.append(attn)\n\n#         outputs = torch.stack(outputs, dim=1)\n#         attention_weights = torch.stack(attention_weights, dim=1)\n#         return outputs, attention_weights","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T08:54:30.590780Z","iopub.execute_input":"2025-02-12T08:54:30.591146Z","iopub.status.idle":"2025-02-12T08:54:30.603326Z","shell.execute_reply.started":"2025-02-12T08:54:30.591119Z","shell.execute_reply":"2025-02-12T08:54:30.602363Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"def ctc_loss(outputs, labels, input_lengths, label_lengths):\n    \n    ## gives error that batch_first is invalid argument, now I will be transposing the probabilities before passing it to the function.\n    # log_probs = outputs.log_softmax(2)  # (batch_size, sequence_length, num_classes)\n    # ctc_loss_fn = nn.CTCLoss(blank=0, batch_first=True)  # Add batch_first=True\n    # return ctc_loss_fn(log_probs, labels, input_lengths, label_lengths)\n\n\n    \"\"\"\n    Compute CTC loss.\n    \n    Args:\n        outputs (torch.Tensor): Model outputs of shape (batch_size, sequence_length, num_classes).\n        labels (torch.Tensor): Ground truth labels of shape (batch_size, target_length).\n        input_lengths (torch.Tensor): Lengths of the input sequences (batch_size,).\n        label_lengths (torch.Tensor): Lengths of the target sequences (batch_size,).\n    \n    Returns:\n        torch.Tensor: CTC loss.\n    \"\"\"\n    log_probs = outputs.log_softmax(2)  # Apply log-softmax to outputs\n    log_probs = log_probs.transpose(0, 1)  # Transpose to (sequence_length, batch_size, num_classes)\n    return nn.CTCLoss(blank=0)(log_probs, labels, input_lengths, label_lengths)\n\n# def ctc_loss(outputs, labels, input_lengths, label_lengths):\n#     \"\"\"\n#     Compute CTC loss.\n    \n#     Args:\n#         outputs (torch.Tensor): Model outputs of shape (batch_size, sequence_length, num_classes).\n#         labels (torch.Tensor): Ground truth labels of shape (batch_size, target_length).\n#         input_lengths (torch.Tensor): Lengths of the input sequences (batch_size,).\n#         label_lengths (torch.Tensor): Lengths of the target sequences (batch_size,).\n    \n#     Returns:\n#         torch.Tensor: CTC loss.\n#     \"\"\"\n#     log_probs = outputs.log_softmax(2)  # Apply log-softmax to outputs\n#     return nn.CTCLoss()(log_probs, labels, input_lengths, label_lengths)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T10:07:47.199348Z","iopub.execute_input":"2025-02-12T10:07:47.200313Z","iopub.status.idle":"2025-02-12T10:07:47.205820Z","shell.execute_reply.started":"2025-02-12T10:07:47.200279Z","shell.execute_reply":"2025-02-12T10:07:47.204808Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"# greedy decoding technique\ndef greedy_decode(output, blank_idx=0):\n    \"\"\"\n    Greedy decoding for CTC loss.\n    \n    Args:\n        output (torch.Tensor): Model output of shape (batch_size, sequence_length, num_classes).\n        blank_idx (int): Index of the blank token (default is 0).\n    \n    Returns:\n        list: List of decoded sequences for each batch.\n    \"\"\"\n    output = F.log_softmax(output, dim=-1)  # Apply log-softmax to get log-probabilities\n    pred = torch.argmax(output, dim=-1)  # Get the index of the max probability\n    pred = pred.detach().cpu().numpy()  # Convert to NumPy array\n    \n    decoded_sequences = []\n    for seq in pred:  # Iterate over each sequence in the batch\n        decoded_sequence = []\n        last_char = -1\n        for char in seq:  # Iterate over each time step in the sequence\n            if char != blank_idx and char != last_char:  # Remove blanks and repeated characters\n                decoded_sequence.append(char)\n            last_char = char\n        decoded_sequences.append(decoded_sequence)\n    \n    return decoded_sequences\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T09:03:48.853012Z","iopub.execute_input":"2025-02-12T09:03:48.853733Z","iopub.status.idle":"2025-02-12T09:03:48.859055Z","shell.execute_reply.started":"2025-02-12T09:03:48.853705Z","shell.execute_reply":"2025-02-12T09:03:48.858199Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"## New train_model Function based on new ctc_loss function\ndef train_model(model, dataloader, optimizer, num_epochs=1000):\n    model.train()\n    losses = []\n    accuracies = []\n\n    for epoch in range(num_epochs):\n        epoch_loss = 0\n        epoch_accuracy = 0\n\n        for images, labels in tqdm(dataloader):\n            images = images.to(device)\n            labels = labels.to(device)  # Labels are already tensors\n\n            optimizer.zero_grad()\n            outputs, _ = model(images)\n            \n            # Create input_lengths tensor\n            input_lengths = torch.full((images.size(0),), outputs.size(1), dtype=torch.long).to(device)\n            \n            # Create label_lengths tensor\n            label_lengths = torch.tensor([len(label) for label in labels], dtype=torch.long).to(device)\n\n            # Compute CTC loss\n            loss = ctc_loss(outputs, labels, input_lengths, label_lengths)\n            loss.backward()\n            optimizer.step()\n\n            epoch_loss += loss.item()\n            \n            # Decode outputs using the updated greedy_decode function\n            decoded_outputs = greedy_decode(outputs)\n            \n            # Convert labels to list of lists for comparison\n            labels_list = [label.tolist() for label in labels]\n            \n            # Calculate accuracy\n            correct = 0\n            for decoded, label in zip(decoded_outputs, labels_list):\n                if decoded == label:\n                    correct += 1\n            epoch_accuracy += correct / len(labels_list)\n\n        epoch_loss /= len(dataloader)\n        epoch_accuracy /= len(dataloader)\n        losses.append(epoch_loss)\n        accuracies.append(epoch_accuracy)\n\n        if (epoch + 1) % 10 == 0:\n            print(f\"Epoch [{epoch+1}/{num_epochs}], Loss: {epoch_loss:.4f}, Accuracy: {epoch_accuracy:.4f}\")\n            visualize_attention(model, dataloader)\n            visualize_embeddings(model.cnn_encoder, dataloader)\n            plot_performance_metrics(losses, accuracies)\n\n    return losses, accuracies","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-02-12T10:08:39.936542Z","iopub.execute_input":"2025-02-12T10:08:39.937395Z","iopub.status.idle":"2025-02-12T10:08:39.945776Z","shell.execute_reply.started":"2025-02-12T10:08:39.937361Z","shell.execute_reply":"2025-02-12T10:08:39.944911Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"# def train_model(model, dataloader, optimizer, num_epochs=1000):\n#     model.train()\n#     losses = []\n#     accuracies = []\n\n#     for epoch in range(num_epochs):\n#         epoch_loss = 0\n#         epoch_accuracy = 0\n\n#         for images, labels in tqdm(dataloader):\n#             images = images.to(device)\n#             labels = labels.to(device)  # Labels are already tensors\n\n#             optimizer.zero_grad()\n#             outputs, _ = model(images)\n            \n#             # Create input_lengths tensor\n#             input_lengths = torch.full((images.size(0),), outputs.size(1), dtype=torch.long).to(device)\n            \n#             # Create label_lengths tensor\n#             label_lengths = torch.tensor([len(label) for label in labels], dtype=torch.long).to(device)\n\n#             # Compute CTC loss\n#             loss = ctc_loss(outputs, labels, input_lengths, label_lengths)\n#             loss.backward()\n#             optimizer.step()\n\n#             epoch_loss += loss.item()\n            \n#             # Decode outputs using the updated greedy_decode function\n#             decoded_outputs = greedy_decode(outputs)\n            \n#             # C